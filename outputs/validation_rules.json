{
  "not_null": ["LineId", "Date", "Time", "Component", "Content", "EventId"],
  "unique": ["LineId"],
  "in_set": {
    "Level": ["Info", "Warning", "Error", "Critical"],
    "Component": ["CBS", "CSI"],
    "event_class": ["FAILURE", "WARNING", "SESSION", "PACKAGE", "INIT", "REBOOT", "INFO"]
  },
  "regex": {
    "EventId": "E\\d+",
    "Date": "\\d{4}-\\d{2}-\\d{2}"
  },
  "between": {
    "param_count": { "min": 0, "max": 20 },
    "LineId": { "min": 1, "max": 100000 }
  },
  "mean_between": {
    "has_failure": { "min": 0.0, "max": 0.5 }
  }
}
